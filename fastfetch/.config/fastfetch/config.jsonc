{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
      "type": "auto",
      "source": "/home/james/.config/fastfetch/frieren.jpg",
      "width": 25,
      "height": 10,
      "padding": {
		  "top": 1,
		  "left": 1,
		  "right": 2
      }
  },
  "modules": [
      {
	  "keyColor": "#888888",
	  "type": "title",
	  "format": "{user-name}@{host-name}",
	  "keyColor": "#888888"
      },
      {
	  "type": "separator",
	  "key": "SEPARATOR",
	  "format": "",
      },
      {
	  "keyColor": "#888888",
	  "type": "os",
	  "key": "OS",
	  "format": "{pretty-name}",
      },
      {
	  "keyColor": "#888888",
	  "type": "host",
	  "key": "HOST",
	  "format": "{family}"
      },
      {
	  "keyColor": "#888888",
	  "type": "kernel",
	  "key": "KERNEL",
	  "format": "{sysname}"
      },
      {
	  "keyColor": "#888888",
	  "type": "uptime",
	  "key": "UPTIME",
	  "format": "",
      },
      {
	  "keyColor": "#888888",
	  "type": "wm",
	  "key": "WM",
	  "format": "{pretty-name}"
      },
      {
	  "keyColor": "#888888",
	  "type": "terminal",
	  "key": "TERMINAL",
	  "format": "{pretty-name}"
      },
      {
	  "keyColor": "#888888",
	  "type": "cpu",
	  "key": "CPU",
	  "format": "{cores-physical}/{cores-logical}cores {freq-base}"
      },
      {
	  "keyColor": "#888888",
	  "type": "gpu",
	  "key": "GPU",
	  "format": ""
      },
      {
	  "keyColor": "#888888",
	  "type": "memory",
	  "key": "MEMORY",
	  "format": "{used} / {total} ({percentage})"
      },
      {
	  "keyColor": "#888888",
	  "type": "disk",
	  "key": "DISK",
	  "format": "{size-used} / {size-total}"
      },
      {
	  "keyColor": "#888888",
	  "type": "battery",
	  "key": "BATTERY",
	  "outputColor": "blue",
	  "format": "{#15}{capacity}{#}"
      }
  ]
}
