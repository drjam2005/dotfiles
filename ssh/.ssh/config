# Main GitHub account
Host gh-main
  HostName ssh.github.com
  Port 443
  User git
  IdentityFile ~/.ssh/id_main
  IdentitiesOnly yes

# School GitHub account
Host gh-school
  HostName ssh.github.com
  Port 443
  User git
  IdentityFile ~/.ssh/id_school
  IdentitiesOnly yes

Host github.com
  HostName ssh.github.com
  Port 443
  User git
  IdentityFile ~/.ssh/id_main
  IdentitiesOnly yes
